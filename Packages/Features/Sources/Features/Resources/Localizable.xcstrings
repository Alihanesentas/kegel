    "onboarding.goal.title" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "How it works" } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Nasıl çalışır" } } } },
    "onboarding.goal.body %lld" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Short sessions, done regularly. Aim for %lld a week. Each session tells you when to squeeze and when to release — you don't need to watch the screen." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kısa seanslar, düzenli olarak. Haftada %lld seans hedefleyin. Her seans ne zaman sıkacağınızı ve ne zaman bırakacağınızı söyler — ekrana bakmanız gerekmez." } } } },
    "onboarding.reminder.title" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "A daily nudge" } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Günlük hatırlatma" } } } },
    "onboarding.reminder.body" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Pick a time that fits your day. You can change or turn this off later." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gününüze uyan bir saat seçin. Sonradan değiştirebilir veya kapatabilirsiniz." } } } },
    "onboarding.reminder.toggle" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Remind me daily" } },
