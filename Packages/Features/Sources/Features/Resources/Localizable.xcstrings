    "health.body.notAdvice" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "This app is an exercise guide. It is not medical advice and does not diagnose anything." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu uygulama bir egzersiz rehberidir. Tıbbi tavsiye değildir ve teşhis koymaz." } } } },
    "health.body.seeDoctor" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "If you have a complaint or a question about your health, talk to a doctor." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir şikayetiniz veya sağlığınızla ilgili bir sorunuz varsa hekiminize danışın." } } } },
    "health.body.stopIfPain" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop if an exercise hurts." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir egzersiz ağrı veriyorsa bırakın." } } } },
