// Copy to Secrets.xcconfig (gitignored) and fill in.
// Then set it as the project's base configuration in Xcode, or pass it on the
// xcodebuild command line.
//
// The public SDK key from the RevenueCat dashboard — starts with "appl_".
// This one is safe to ship in a binary; the *secret* key never goes near the app.
REVENUECAT_API_KEY = appl_YOUR_KEY_HERE
